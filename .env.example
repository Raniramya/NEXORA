# Backend
NEXORA_ENVIRONMENT=development
NEXORA_DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora_cdi
NEXORA_CORS_ORIGINS=http://localhost:3000
NEXORA_LOG_LEVEL=INFO
NEXORA_EDGE_INGEST_TOKEN=
NEXORA_API_URL=http://localhost:8000
NEXORA_MQTT_HOST=localhost
NEXORA_MQTT_PORT=1883
NEXORA_MQTT_TOPIC=nexora/machines/+/signal-windows
NEXORA_MQTT_CLIENT_ID=nexora-edge-bridge
NEXORA_MQTT_USERNAME=
NEXORA_MQTT_PASSWORD=
NEXORA_MQTT_TLS=false
NEXORA_MQTT_CA_FILE=

# Frontend (public, non-secret configuration only)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
